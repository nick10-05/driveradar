# Copy to backend/.env for local development. Never commit .env.
# Every variable is documented in docs/DESIGN.md §7.2.

ENVIRONMENT=dev

# Local Docker Postgres (docker compose up -d db).
# For Neon, paste its *direct* (non-pooler) connection string as-is; sslmode/channel_binding are handled.
DATABASE_URL=postgresql://driveradar:driveradar@localhost:5432/driveradar

# Comma-separated origins allowed to send unsafe (POST/PUT/PATCH/DELETE) requests.
ALLOWED_ORIGINS=http://localhost:5173

# Shared code students need to register (min 8 characters).
BATCH_INVITE_CODE=change-me-invite-code

# Secret header value for POST /internal/run-reminders (min 16 characters).
CRON_SECRET=change-me-to-a-long-random-string

SESSION_TTL_HOURS=168
# Keep true. Set false only in dev if your browser refuses Secure cookies on http://localhost
# (the cookie is then named "session" instead of "__Host-session"). Rejected outside dev.
SESSION_COOKIE_SECURE=true
LOG_LEVEL=INFO

# Telegram alerts (Day 8). Optional: set all three or leave all empty (= Telegram off).
# Token and username come from @BotFather. The webhook secret is any 16-256 characters
# of A-Z a-z 0-9 _ - (e.g. `openssl rand -hex 32`). Register the webhook with
# `uv run python -m app.scripts.set_telegram_webhook https://<backend-host>`.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# Public frontend URL, used for drive links in alerts (optional).
APP_BASE_URL=http://localhost:5173

# AI extraction (Day 4). "none" = manual entry, ₹0.
LLM_PROVIDER=none
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_JSON_MODE=schema
LLM_TIMEOUT_SECONDS=30
